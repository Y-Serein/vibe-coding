#!/bin/sh

case "$1" in
  start)
	. /etc/profile
	AIKB_BOOT_VIEW="${AIKB_VIEW:-dashboard}"
	if [ "${AIKB_BOOT_VIEW}" != "video" ]; then
		if [ ! -e /dev/fb0 ] && [ -f /mnt/system/ko/soph_fb.ko ]; then
			insmod /mnt/system/ko/soph_fb.ko option=1 opt_bpp=32 \
				>/tmp/aikb_fb_init.log 2>&1 || true
		fi
		if [ -e /dev/fb0 ]; then
			echo "fb ready; defer open to aikb_lcd_ui" \
				>>/tmp/aikb_fb_init.log
		fi
		echo "fb clear handled by soph_fb/aikb_lcd_ui" \
			>>/tmp/aikb_fb_init.log
	else
		echo "video mode: skip framebuffer init" >/tmp/aikb_fb_init.log
	fi
	if [ -x /mnt/system/auto.sh ]; then
		AIKB_VIEW="${AIKB_BOOT_VIEW}" sh /mnt/system/auto.sh &
	else
		echo "/mnt/system/auto.sh not executable" > /tmp/aikb_lcd_ui.log
	fi
	;;
  stop)
	killall sample_vdecvo >/dev/null 2>&1 || true
	if [ -f /tmp/aikb_video_controller.pid ]; then
		kill "$(cat /tmp/aikb_video_controller.pid)" >/dev/null 2>&1 || true
		rm -f /tmp/aikb_video_controller.pid
	fi
	killall aikb_hid_input >/dev/null 2>&1 || true
	killall aikb_lcd_ui >/dev/null 2>&1 || true
	if [ -f /tmp/aikb_fb_keeper.pid ]; then
		kill "$(cat /tmp/aikb_fb_keeper.pid)" >/dev/null 2>&1 || true
		rm -f /tmp/aikb_fb_keeper.pid
	fi
	;;
  restart)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac

exit 0
