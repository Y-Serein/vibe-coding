#!/bin/sh

case "$1" in
  start)
	. /etc/profile
	if [ ! -e /dev/fb0 ] && [ -f /mnt/system/ko/soph_fb.ko ]; then
		insmod /mnt/system/ko/soph_fb.ko option=1 opt_bpp=32 \
			>/tmp/aikb_fb_init.log 2>&1 || true
	fi
	# Push panel-format pre-rotated still (IMG_9876 packed by
	# scripts/make_splash_fb.py) to /dev/fb0 the instant fb is up so the
	# green panel-init pattern is overwritten before aikb_lcd_ui's first
	# fb_blit lands.
	if [ -e /dev/fb0 ] && [ -f /mnt/system/usr/share/aikb/splash_fb.bin ]; then
		dd if=/mnt/system/usr/share/aikb/splash_fb.bin \
			of=/dev/fb0 bs=1582080 count=1 conv=notrunc \
			>>/tmp/aikb_fb_init.log 2>&1 || true
	fi
	if [ -x /mnt/system/auto.sh ]; then
		sh /mnt/system/auto.sh &
	else
		echo "/mnt/system/auto.sh not executable" > /tmp/aikb_lcd_ui.log
	fi
	;;
  stop)
	killall aikb_hid_input >/dev/null 2>&1 || true
	killall aikb_lcd_ui >/dev/null 2>&1 || true
	;;
  restart)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac

exit 0
